# ============================================================================
# Oracle Autonomous Database + Azure Key Vault Deployment Configuration
# ============================================================================
# Copy this file to .env and update with your values
# Note: .env is gitignored for security
# ============================================================================

# ============================================================================
# Azure Configuration (REQUIRED)
# ============================================================================

# Azure region for resource deployment
# Example: eastus, westus, uksouth, westeurope
AZ_LOCATION=uksouth

# Optional: Azure Subscription ID
# If not set, uses the currently active subscription
AZURE_SUBSCRIPTION_ID=

# ============================================================================
# Oracle Autonomous Database Configuration (REQUIRED)
# ============================================================================

# CRITICAL: Admin password for Oracle Autonomous Database
# Requirements:
#   - 12-30 characters
#   - At least 1 uppercase letter
#   - At least 1 lowercase letter
#   - At least 1 number
#   - Cannot contain username
#   - Cannot contain double quotes (")
# SECURITY: Consider using environment variable instead:
#   export TF_VAR_adbs_admin_password="YourSecureP@ssw0rd123"
ADBS_ADMIN_PASSWORD=

# ============================================================================
# Optional: Oracle ADBS Advanced Configuration
# ============================================================================
# If not set, default values from variables.tf will be used

# Database display name (user-friendly name)
# ADBS_DISPLAY_NAME="Oracle Autonomous Database - Production"

# Database version: 19c, 21c, 23ai
# ADBS_DB_VERSION=19c

# Workload type: OLTP, DW, AJD, APEX
# ADBS_WORKLOAD=OLTP

# Compute model: ECPU, OCPU
# ADBS_COMPUTE_MODEL=ECPU

# Compute count (1-512)
# ADBS_COMPUTE_COUNT=2

# Storage size in TB (1-384)
# ADBS_STORAGE_SIZE_TBS=1

# License model: LicenseIncluded, BringYourOwnLicense
# ADBS_LICENSE_MODEL=LicenseIncluded

# Backup retention in days (1-60)
# ADBS_BACKUP_RETENTION_DAYS=60

# Auto scaling: true, false
# ADBS_AUTO_SCALING_ENABLED=true
# ADBS_AUTO_SCALING_STORAGE_ENABLED=false

# Mutual TLS required: true, false
# ADBS_MTLS_REQUIRED=false

# Character sets
# ADBS_CHARACTER_SET=AL32UTF8
# ADBS_NATIONAL_CHARACTER_SET=AL16UTF16

# Database name (used for resource naming)
# ADBS_NAME=autdbtestakv

# ============================================================================
# Logging and Monitoring Configuration (OPTIONAL)
# ============================================================================

# Enable Log Analytics Workspace and diagnostic settings
# When false, Log Analytics Workspace will NOT be deployed
ENABLE_LOG_ANALYTICS=true

# Enable Event Hub for log streaming
# When true, Event Hub Namespace and Event Hub will be deployed
ENABLE_EVENTHUB_LOGGING=false

# ============================================================================
# Azure Key Vault Managed HSM Configuration (OPTIONAL)
# ============================================================================

# Deploy Azure Key Vault Managed HSM
# WARNING: Managed HSM is expensive and takes ~15 minutes to provision
# Set to false to use standard Azure Key Vault only
DEPLOY_MANAGED_HSM=false

# ============================================================================
# Terraform Configuration (OPTIONAL)
# ============================================================================

# Terraform logging level: TRACE, DEBUG, INFO, WARN, ERROR
TF_LOG=INFO

# Terraform working directory
TERRAFORM_WORK_DIR=./infra-deployment

# Auto-approve Terraform apply (USE WITH CAUTION)
# When true, will not prompt for confirmation
TERRAFORM_AUTO_APPROVE=false

# ============================================================================
# Jumpbox VM Configuration (OPTIONAL)
# ============================================================================
# If not set, default values from variables.tf will be used

# VM name (alphanumeric and hyphens only)
# JUMPBOX_NAME=VM-DevBox

# VM size
# JUMPBOX_SIZE=Standard_D2s_v3

# Admin username (1-20 characters)
# JUMPBOX_ADMIN_USERNAME=azureadmin

# Enable public IP address
# JUMPBOX_ENABLE_PUBLIC_IP=false

# OS disk size in GB
# JUMPBOX_OS_DISK_SIZE_GB=127

# OS disk type: Standard_LRS, StandardSSD_LRS, Premium_LRS, UltraSSD_LRS
# JUMPBOX_OS_DISK_TYPE=Premium_LRS

# ============================================================================
# Deployment Metadata (OPTIONAL)
# ============================================================================

# Environment tag: Dev, Test, Staging, Production
ENVIRONMENT=Test

# Project name tag
PROJECT=Oracle-ADBS-AKV

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env file to version control
# 2. Store sensitive values in Azure Key Vault when possible
# 3. Use Azure Managed Identity for production deployments
# 4. Rotate passwords regularly
# 5. Consider using terraform.tfvars for non-sensitive overrides
# ============================================================================
