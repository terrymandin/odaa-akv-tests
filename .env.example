# ============================================================================
# Oracle Exascale + Azure Key Vault Deployment Configuration
# ============================================================================
# Copy this file to .env and update with your values
# Note: .env is gitignored for security
# ============================================================================

# ============================================================================
# Azure Configuration (REQUIRED)
# ============================================================================

# Azure region for resource deployment
# Example: eastus, westus, eastus, westeurope
AZ_LOCATION=eastus

# Optional: Azure Subscription ID
# If not set, uses the currently active subscription
AZURE_SUBSCRIPTION_ID=

# ============================================================================
# Oracle Exascale Configuration (REQUIRED)
# ============================================================================

# Enable Exascale deployment mode
# When true: deploys Oracle Exascale Storage Vault + VM Cluster
# When false: deploys Oracle Autonomous Database Serverless (ADB Serverless)
DEPLOY_EXASCALE=true

# SSH public key for Exascale VM Cluster node access
# SECURITY: Recommended to set via environment variable instead:
#   export TF_VAR_oracle_ssh_public_key="$(cat ~/.ssh/id_rsa.pub)"
ORACLE_SSH_PUBLIC_KEY=

# ============================================================================
# Optional: Oracle Exascale Advanced Configuration
# ============================================================================
# If not set, default values from variables.tf will be used.
# For full object-level overrides use terraform.tfvars (see terraform.tfvars.example)

# Availability zone for the Exascale Storage Vault ("1", "2", or "3")
# EXASCALE_VAULT_AZ=1

# Storage Vault size in GiB (minimum 300)
# EXASCALE_VAULT_STORAGE_GBS=300

# Storage Vault display name (auto-generated if empty)
# EXASCALE_VAULT_DISPLAY_NAME=

# Exascale VM Cluster shape name (e.g. Exadata.X11M)
# EXASCALE_CLUSTER_SHAPE=Exadata.X11M

# Number of ECPUs to enable on the cluster (min 0)
# EXASCALE_CLUSTER_ENABLED_ECPU_COUNT=4

# Total ECPUs allocated to the cluster (min 2, must be >= enabled)
# EXASCALE_CLUSTER_TOTAL_ECPU_COUNT=4

# Number of VM Cluster nodes
# EXASCALE_CLUSTER_NODE_COUNT=2

# Hostname prefix for cluster nodes (max 12 characters)
# EXASCALE_CLUSTER_HOSTNAME=exahost

# Short cluster identifier used in Oracle (max 11 characters)
# EXASCALE_CLUSTER_NAME=exacluster

# License model: LicenseIncluded, BringYourOwnLicense
# EXASCALE_CLUSTER_LICENSE_MODEL=LicenseIncluded

# Cluster time zone (e.g. UTC, US/Eastern)
# EXASCALE_CLUSTER_TIME_ZONE=UTC

# ============================================================================
# Logging and Monitoring Configuration (OPTIONAL)
# ============================================================================

# Enable Log Analytics Workspace and diagnostic settings
# When false, Log Analytics Workspace will NOT be deployed
ENABLE_LOG_ANALYTICS=true

# Enable Event Hub for log streaming
# When true, Event Hub Namespace and Event Hub will be deployed
ENABLE_EVENTHUB_LOGGING=false

# ============================================================================
# Azure Key Vault Configuration (OPTIONAL)
# ============================================================================

# Azure Key Vault SKU tier:
#   standard - software-protected keys (default)
#   premium  - HSM-backed keys within AKV (higher cost; same API as standard)
# For a dedicated Hardware Security Module, use DEPLOY_MANAGED_HSM=true instead.
KEY_VAULT_SKU=standard

# ============================================================================
# Azure Key Vault Managed HSM Configuration (OPTIONAL)
# ============================================================================

# Deploy Azure Key Vault Managed HSM
# WARNING: Managed HSM is expensive and takes ~15 minutes to provision
# Set to false to use standard Azure Key Vault only
DEPLOY_MANAGED_HSM=false

# ============================================================================
# Terraform Configuration (OPTIONAL)
# ============================================================================

# Terraform logging level: TRACE, DEBUG, INFO, WARN, ERROR
TF_LOG=INFO

# Terraform working directory
TERRAFORM_WORK_DIR=./infra-deployment

# Auto-approve Terraform apply (USE WITH CAUTION)
# When true, will not prompt for confirmation
TERRAFORM_AUTO_APPROVE=false

# ============================================================================
# Jumpbox VM Configuration (OPTIONAL)
# ============================================================================
# If not set, default values from variables.tf will be used

# VM name (alphanumeric and hyphens only)
# JUMPBOX_NAME=VM-DevBox

# VM size
# JUMPBOX_SIZE=Standard_D2s_v3

# Admin username (1-20 characters)
# JUMPBOX_ADMIN_USERNAME=azureadmin

# Enable public IP address
# JUMPBOX_ENABLE_PUBLIC_IP=false

# OS disk size in GB
# JUMPBOX_OS_DISK_SIZE_GB=127

# OS disk type: Standard_LRS, StandardSSD_LRS, Premium_LRS, UltraSSD_LRS
# JUMPBOX_OS_DISK_TYPE=Premium_LRS

# ============================================================================
# Deployment Metadata (OPTIONAL)
# ============================================================================

# Environment tag: Dev, Test, Staging, Production
ENVIRONMENT=Test

# Project name tag
PROJECT=Oracle-Exascale-AKV

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env file to version control
# 2. Store sensitive values in Azure Key Vault when possible
# 3. Use Azure Managed Identity for production deployments
# 4. Rotate passwords regularly
# 5. Consider using terraform.tfvars for non-sensitive overrides
# ============================================================================




