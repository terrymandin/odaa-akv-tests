# Example Terraform variables file
# Copy this file to terraform.tfvars and update with your values
# Note: terraform.tfvars is gitignored for security

# Resource Configuration
location = "eastus"
oracle_subnet_prefix_length = 27  # Allowed range: /27 to /29

# ============================================================================
# Deployment Mode: Exascale
# ============================================================================
# This repository is configured for Oracle Exascale deployment.
deploy_exascale = true

# Set to false to skip creating the Windows jumpbox VM and related resources.
deploy_jumpbox_vm = true

# Azure Key Vault SKU: "standard" (default) or "premium" (HSM-backed keys in AKV)
# For a dedicated Hardware Security Module, set deploy_managed_hsm = true instead.
# key_vault_sku = "standard"

# Logging Configuration
# Enable or disable Log Analytics Workspace, Diagnostic Settings, and Workbook
# When set to false, the following resources will NOT be deployed:
# - Log Analytics Workspace
# - Diagnostic Settings for all services (Key Vault, VNet, Firewall, NSG)
# - Azure Firewall Workbook for denied traffic monitoring
enable_log_analytics_logging = true  # Set to false to disable Log Analytics infrastructure

# Event Hub Logging Configuration
# Enable or disable Event Hub for streaming diagnostic logs
# When set to true, the following resources will be deployed:
# - Event Hub Namespace (Standard SKU)
# - Event Hub for diagnostic logs
# - Separate diagnostic settings for Key Vault, VNet, Firewall, and NSG to stream to Event Hub
# Note: This is independent from Log Analytics logging. Both can be enabled simultaneously.
enable_eventhub_logging = false  # Set to true to enable Event Hub log streaming

# IMPORTANT: Admin Password Configuration
# RECOMMENDED: Set this via environment variable for security
# Example: export TF_VAR_jumpbox_admin_password="YourSecureP@ssw0rd123"
# 
# Admin password requirements:
# - 12-30 characters
# - Must include: uppercase, lowercase, number, and special character
#
# REQUIRED when deploy_jumpbox_vm = true: set jumpbox_admin_password in terraform.tfvars or TF_VAR_jumpbox_admin_password
jumpbox_admin_password = "YourSecureP@ssw0rd123"

# Tags
tags = {
  "Created by" = "temandin"
  Expiration = "10-Jul-26"
  Purpose = "AKV Testing"
}

# ============================================================================
# Oracle Exascale Configuration (used when deploy_exascale = true)
# ============================================================================

# SSH public key for VM Cluster node access — required for Exascale.
# RECOMMENDED: set via env var instead of committing the key here:
#   export TF_VAR_oracle_ssh_public_key="$(cat ~/.ssh/id_rsa.pub)"
# oracle_ssh_public_key = "ssh-rsa AAAA..."

